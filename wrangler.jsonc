{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alpha-ins",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "alpha-ins"
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://alpha-ins.aalphanation.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://fyndiedplgyiowqvkfsk.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_TK2l53Bvk9PHiJ1qcFnN5A_S6UesLH4",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGDdocppk4-pTNuA",
    "TURNSTILE_ALLOWED_HOSTNAMES": "alpha-ins.aalphanation.workers.dev"
  },
  "previews": {
    "vars": {
      "NEXTJS_ENV": "production",
      "NEXT_PUBLIC_SITE_URL": "https://alpha-ins.aalphanation.workers.dev",
      "NEXT_PUBLIC_SUPABASE_URL": "https://fyndiedplgyiowqvkfsk.supabase.co",
      "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_TK2l53Bvk9PHiJ1qcFnN5A_S6UesLH4",
      "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGDdocppk4-pTNuA",
      "TURNSTILE_ALLOWED_HOSTNAMES": "alpha-ins.aalphanation.workers.dev"
    }
  }
}